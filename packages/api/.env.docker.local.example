# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=debug

# Seed Passwords (development only)
SEED_ADMIN_PASSWORD=YourAdminPassword123!
SEED_USER_PASSWORD=YourUserPassword123!
