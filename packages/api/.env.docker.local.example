# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (Docker network)
DB_HOST=mysql
DB_PORT=3306
DB_USER=poduim
DB_PASSWORD=your_dev_password_here
